:root {
  --green: #237a57; --green-dark: #17563e; --mint: #e9f4ed; --cream: #fffaf3;
  --ink: #202b25; --muted: #68746c; --peach: #f6d8c8; --yellow: #f6d879;
  --white: #fff; --line: #e6eae5; --shadow: 0 18px 50px rgba(35, 74, 53, .10);
  --radius: 24px;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 90px; }
body { margin: 0; font-family: "DM Sans", sans-serif; color: var(--ink); background: var(--cream); line-height: 1.6; }
img { display: block; width: 100%; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
.container { width: min(1160px, calc(100% - 44px)); margin: 0 auto; }
.skip-link { position: absolute; left: -9999px; top: 0; background: white; padding: 10px; z-index: 99; }
.skip-link:focus { left: 10px; }
.site-header { position: sticky; top: 0; z-index: 20; background: rgba(255,250,243,.94); backdrop-filter: blur(14px); border-bottom: 1px solid rgba(230,234,229,.75); }
.nav-wrap { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
.brand { display: inline-flex; align-items: center; gap: 9px; font-family: "Nunito", sans-serif; font-size: 1.24rem; font-weight: 900; letter-spacing: -.7px; white-space: nowrap; }
.brand-mark { display: grid; place-items: center; width: 39px; height: 39px; border-radius: 13px; background: var(--green); color: white; font-size: 1.2rem; }
.brand-accent { color: var(--green); }
.main-nav { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 32px); font-size: .91rem; font-weight: 700; }
.main-nav > a:not(.nav-cta) { color: #526058; transition: color .2s; }
.main-nav > a:not(.nav-cta):hover { color: var(--green); }
.nav-cta { background: var(--green); color: white; padding: 12px 17px; border-radius: 999px; transition: transform .2s, background .2s; }
.nav-cta:hover, .button-primary:hover { background: var(--green-dark); transform: translateY(-2px); }
.nav-cta span { padding-left: 5px; }
.menu-toggle { display: none; border: 0; background: transparent; color: var(--green-dark); font-size: 1.6rem; cursor: pointer; }
.section { padding: 94px 0; }
.hero { padding-top: 72px; padding-bottom: 80px; overflow: hidden; }
.hero-grid { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: 55px; }
.eyebrow { display: inline-flex; align-items: center; gap: 9px; color: var(--green); text-transform: uppercase; letter-spacing: 1.6px; font-size: .74rem; font-weight: 800; }
.eyebrow-dot { width: 8px; height: 8px; background: #e9a66d; border-radius: 50%; box-shadow: 0 0 0 5px #f8e8d8; }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { font-family: "Nunito", sans-serif; line-height: 1.13; letter-spacing: -1.4px; }
h1 { font-size: clamp(3rem, 5.5vw, 5rem); margin: 19px 0 22px; font-weight: 900; }
h1 span, h2 span { color: var(--green); }
.hero-text { max-width: 520px; color: var(--muted); font-size: 1.1rem; line-height: 1.8; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 13px; margin-top: 30px; }
.button { display: inline-flex; justify-content: center; align-items: center; gap: 13px; border: 0; border-radius: 999px; padding: 15px 22px; font-weight: 800; font-size: .93rem; cursor: pointer; transition: transform .2s, background .2s; }
.button-primary { color: white; background: var(--green); box-shadow: 0 9px 20px rgba(35,122,87,.18); }
.button-secondary { background: white; color: var(--green-dark); border: 1px solid var(--line); }
.button-secondary:hover { border-color: var(--green); transform: translateY(-2px); }
.hero-proof { display: flex; align-items: center; gap: 13px; margin-top: 34px; }
.proof-avatars { display: flex; }
.proof-avatars span { display: grid; place-items: center; width: 37px; height: 37px; border: 3px solid var(--cream); border-radius: 50%; background: var(--mint); margin-left: -7px; font-size: 1rem; }
.proof-avatars span:first-child { margin-left: 0; }
.hero-proof p { margin: 0; color: var(--muted); font-size: .82rem; line-height: 1.4; }
.hero-proof strong { color: var(--ink); }
.hero-art { position: relative; min-height: 465px; display: grid; place-items: center; }
.hero-blob { position: absolute; width: 88%; height: 91%; border-radius: 48% 52% 40% 60% / 48% 43% 57% 52%; background: #e0eddf; transform: rotate(-7deg); }
.hero-photo { position: relative; width: 78%; height: 410px; overflow: hidden; border-radius: 46% 46% 27px 27px; box-shadow: var(--shadow); transform: rotate(2deg); }
.hero-photo img { height: 100%; object-fit: cover; }
.floating-card { position: absolute; z-index: 2; display: flex; align-items: center; gap: 11px; background: white; padding: 13px 17px; border-radius: 16px; box-shadow: 0 12px 35px rgba(32,43,37,.13); }
.floating-card strong, .floating-card small { display: block; }
.floating-card strong { font-size: .85rem; }
.floating-card small { color: var(--muted); font-size: .72rem; }
.float-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--mint); font-size: 1.25rem; }
.floating-card-top { top: 65px; left: -3px; }
.floating-card-bottom { bottom: 50px; right: -2px; }
.decor { position: absolute; color: #e9a66d; font-size: 3rem; }
.decor-one { top: 20px; right: 14px; }
.decor-two { bottom: 15px; left: 30px; font-size: 4rem; }
.impact-strip { background: var(--green); color: white; padding: 24px 0; }
.impact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.impact-grid > div { display: flex; align-items: center; justify-content: center; gap: 13px; }
.impact-icon { display: grid; place-items: center; width: 47px; height: 47px; border-radius: 15px; background: rgba(255,255,255,.14); font-size: 1.35rem; }
.impact-grid p { margin: 0; }
.impact-grid strong, .impact-grid small { display: block; }
.impact-grid strong { font-size: .91rem; }
.impact-grid small { color: #d9eee1; font-size: .77rem; margin-top: 2px; }
.about-section { background: white; }
.about-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 85px; align-items: center; }
.about-visual { position: relative; padding: 0 25px 25px 0; }
.about-visual::before { content: ""; position: absolute; inset: 28px 0 0 28px; background: var(--peach); border-radius: 25px; }
.about-visual img { position: relative; height: 440px; object-fit: cover; border-radius: 25px; }
.about-sticker { position: absolute; right: -25px; bottom: 0; display: flex; align-items: center; gap: 12px; padding: 17px 21px; background: var(--yellow); border-radius: 18px; box-shadow: 0 10px 25px rgba(80,62,10,.12); transform: rotate(-3deg); }
.about-sticker span { font-size: 1.8rem; }
.about-sticker strong { font-family: "Nunito", sans-serif; font-size: .95rem; line-height: 1.25; }
.section-copy h2, .section-heading h2, .center-heading h2, .signup-copy h2 { font-size: clamp(2.2rem, 4vw, 3.35rem); margin: 16px 0 20px; font-weight: 900; }
.section-copy p { color: var(--muted); line-height: 1.85; }
.text-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 10px; color: var(--green); font-weight: 800; font-size: .92rem; }
.text-link:hover { color: var(--green-dark); gap: 12px; }
.pets-section { background: #f5f8f3; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 38px; }
.section-heading h2 { margin-bottom: 0; }
.section-heading > p { max-width: 360px; color: var(--muted); margin-bottom: 5px; }
.pet-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.pet-card { overflow: hidden; background: white; border: 1px solid #edf0eb; border-radius: 22px; padding: 12px 12px 19px; transition: transform .25s, box-shadow .25s; }
.pet-card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
.pet-image { height: 230px; position: relative; overflow: hidden; border-radius: 15px; }
.pet-image img { height: 100%; object-fit: cover; transition: transform .4s; }
.pet-card:hover .pet-image img { transform: scale(1.04); }
.pet-tag { position: absolute; left: 12px; top: 12px; background: rgba(255,255,255,.93); border-radius: 999px; padding: 6px 10px; font-size: .7rem; font-weight: 800; color: var(--green-dark); }
.pet-info { display: flex; justify-content: space-between; align-items: center; padding: 17px 5px 0; }
.pet-info h3 { margin: 0 0 3px; font-size: 1.35rem; letter-spacing: -.4px; }
.pet-info p { margin: 0; color: var(--muted); font-size: .8rem; }
.pet-emoji { font-size: 1.6rem; }
.pet-description { color: var(--muted); font-size: .88rem; line-height: 1.65; padding: 0 5px; min-height: 58px; }
.pet-link { width: calc(100% - 10px); margin: 4px 5px 0; display: flex; justify-content: space-between; padding: 12px 0 0; border: 0; border-top: 1px solid var(--line); background: transparent; color: var(--green); font-weight: 800; cursor: pointer; }
.demo-note { color: #7d867f; font-size: .76rem; margin: 20px 0 0; }
.help-section { background: white; }
.center-heading { max-width: 690px; margin: 0 auto 42px; text-align: center; }
.center-heading h2 { margin-bottom: 13px; }
.center-heading > p { color: var(--muted); }
.help-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.help-card { padding: 28px; border: 1px solid var(--line); border-radius: 22px; background: #fff; transition: transform .2s, box-shadow .2s; }
.help-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
.help-icon { width: 58px; height: 58px; display: grid; place-items: center; border-radius: 18px; font-size: 1.65rem; margin-bottom: 22px; }
.icon-peach { background: #ffebe0; } .icon-green { background: #e4f3e8; } .icon-yellow { background: #fff2c7; }
.help-card h3 { font-size: 1.25rem; letter-spacing: -.4px; margin-bottom: 10px; }
.help-card p { color: var(--muted); font-size: .9rem; line-height: 1.75; min-height: 75px; }
.signup-section { background: #eaf3eb; }
.signup-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 75px; align-items: center; }
.signup-copy h2 { font-size: clamp(2.4rem, 4vw, 3.5rem); }
.signup-copy > p { color: var(--muted); line-height: 1.85; }
.signup-paw { font-size: 5rem; opacity: .22; margin-top: 20px; }
.signup-form { padding: 34px; border-radius: 25px; background: white; box-shadow: 0 15px 45px rgba(31,76,51,.08); }
.signup-form h3 { margin-bottom: 4px; font-size: 1.65rem; letter-spacing: -.5px; }
.form-intro { color: var(--muted); font-size: .9rem; margin-bottom: 22px; }
.form-row { margin-bottom: 16px; }
.two-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
label { display: block; font-size: .82rem; font-weight: 800; color: #35443a; }
label > span, .consent b { color: #c75b45; }
input:not([type="checkbox"]), select, textarea { display: block; width: 100%; margin-top: 7px; border: 1px solid #dfe6df; border-radius: 11px; padding: 12px 13px; background: #fbfcfa; color: var(--ink); outline: none; transition: border .2s, box-shadow .2s; }
input:focus, select:focus, textarea:focus { border-color: var(--green); box-shadow: 0 0 0 3px rgba(35,122,87,.12); }
textarea { resize: vertical; }
.consent { display: flex; align-items: flex-start; gap: 9px; font-size: .75rem; line-height: 1.5; font-weight: 500; color: var(--muted); margin: 6px 0 19px; }
.consent input { margin-top: 3px; accent-color: var(--green); }
.submit-button { width: 100%; }
.privacy-note { font-size: .7rem; color: #7c867e; line-height: 1.5; margin: 13px 0 0; }
.form-feedback { display: none; margin-top: 14px; padding: 12px 14px; border-radius: 10px; font-size: .86rem; }
.form-feedback.visible { display: block; }
.form-feedback.success { background: #e7f6e9; color: #205d35; }
.form-feedback.error { background: #fff0ed; color: #9b382a; }
.site-footer { background: #173f2f; color: white; padding: 35px 0 0; }
.footer-main { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 27px; }
.footer-brand { color: white; }
.footer-brand .brand-accent { color: #9dd9b3; }
.footer-brand .brand-mark { background: rgba(255,255,255,.13); }
.footer-main > p { margin: 0; color: #d1e2d7; font-size: .86rem; }
.back-top { font-weight: 700; font-size: .84rem; color: #d9eee1; }
.footer-bottom { display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(255,255,255,.16); padding: 17px 0; color: #c4d8cb; font-size: .74rem; }
@media (max-width: 900px) {
  .main-nav { gap: 14px; font-size: .82rem; }
  .nav-cta { padding: 10px 12px; }
  .hero-grid { gap: 25px; }
  .hero-art { min-height: 400px; }
  .hero-photo { height: 355px; }
  .about-grid, .signup-grid { gap: 45px; }
  .about-visual img { height: 380px; }
  .pet-image { height: 190px; }
}
@media (max-width: 700px) {
  .container { width: min(100% - 32px, 520px); }
  .nav-wrap { min-height: 70px; }
  .menu-toggle { display: block; }
  .main-nav { display: none; position: absolute; top: 69px; left: 0; right: 0; padding: 18px 22px 22px; background: var(--cream); border-bottom: 1px solid var(--line); box-shadow: 0 15px 20px rgba(20,50,30,.08); flex-direction: column; align-items: stretch; gap: 14px; }
  .main-nav.open { display: flex; }
  .main-nav a { padding: 7px 0; }
  .main-nav .nav-cta { text-align: center; padding: 12px; }
  .section { padding: 68px 0; }
  .hero { padding-top: 52px; }
  .hero-grid, .about-grid, .signup-grid { grid-template-columns: 1fr; gap: 38px; }
  h1 { font-size: clamp(3rem, 13vw, 4.4rem); }
  .hero-text { font-size: 1rem; }
  .hero-art { min-height: 350px; max-width: 480px; width: 100%; margin: 0 auto; }
  .hero-photo { width: 76%; height: 320px; }
  .floating-card-top { top: 35px; left: -3px; }
  .floating-card-bottom { bottom: 28px; right: -2px; }
  .impact-grid { grid-template-columns: 1fr; gap: 18px; }
  .impact-grid > div { justify-content: flex-start; }
  .about-visual { max-width: 470px; }
  .about-visual img { height: 350px; }
  .section-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
  .pet-grid, .help-grid { grid-template-columns: 1fr; }
  .pet-image { height: 250px; }
  .pet-description { min-height: auto; }
  .help-card p { min-height: auto; }
  .signup-form { padding: 24px 19px; }
  .two-cols { grid-template-columns: 1fr; gap: 16px; }
  .footer-main, .footer-bottom { flex-direction: column; align-items: flex-start; }
  .footer-main { gap: 15px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
